<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A dark, action-bar-less window: the UI is Compose and paints its own
      surfaces, so the platform theme only has to avoid a white flash before the
      first frame.
    -->
    <style name="Theme.DynamicGlyph" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
