<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_background"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dragHandle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/drag_window"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/restartRecognitionButton"
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/overlay_start_recognition"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/overlay_start_recognition"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/closeOverlay"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/stop_recognition"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/close_symbol"
            android:textSize="20sp" />
    </LinearLayout>

    <org.szres.glyphlens.overlay.GlyphDiagramView
        android:id="@+id/glyphDiagram"
        android:layout_width="320dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no" />
</LinearLayout>
