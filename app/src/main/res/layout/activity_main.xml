<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textColor="@color/primary_text"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/glyph_only_subtitle"
            android:textColor="@color/secondary_text"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recognition_mode_title"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/recognitionModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/realtimeModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/recognition_mode_realtime"
                android:textColor="@color/primary_text" />
            <RadioButton
                android:id="@+id/powerSavingModeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/recognition_mode_power_saving"
                android:textColor="@color/primary_text" />
        </RadioGroup>
        <TextView
            android:id="@+id/recognitionModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/recognition_mode_realtime_hint"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />
        <Switch
            android:id="@+id/autoHideSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/auto_hide_after_drawing"
            android:textColor="@color/primary_text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/auto_hide_after_drawing_hint"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:padding="16dp"
            android:text="@string/status_ready"
            android:textColor="@color/primary_text"
            android:textSize="16sp" />
        <Button
            android:id="@+id/primaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_capture" />
        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hide_overlay"
            android:visibility="gone" />
        <Switch
            android:id="@+id/floatingWindowSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/floating_window"
            android:textColor="@color/primary_text" />
        <Button
            android:id="@+id/openIngressButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_ingress" />
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />
        <TextView
            android:id="@+id/homeLiveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_live_glyph_title"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/homeLiveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_live_waiting"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />
        <org.szres.glyphlens.overlay.OverlayPreviewView
            android:id="@+id/homeLivePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tables_title"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/importShapesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_shapes" />
        <TextView
            android:id="@+id/shapeTableStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />
        <Button
            android:id="@+id/importSequencesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/import_sequences" />
        <TextView
            android:id="@+id/sequenceTableStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
